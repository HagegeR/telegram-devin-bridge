[Unit]
Description=Telegram Devin Bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=telegram-devin
Group=telegram-devin
WorkingDirectory=/opt/telegram-devin-bridge
EnvironmentFile=-/etc/telegram-devin-bridge.env
ExecStart=/opt/telegram-devin-bridge/.venv/bin/python -m app.poll
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
