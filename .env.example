# Copy to .env and fill in the required values. Optional variables are
# commented out — an empty `KEY=` is not the same as unset (it is parsed
# as an empty string), so keep optional lines commented until you set them.

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
DEVIN_API_KEY=replace-with-devin-api-key
# DEVIN_SERVICE_USER_API_KEY=
# DEVIN_ORG_ID=
TELEGRAM_MODE=webhook
PUBLIC_BASE_URL=https://your-host.example.com
DATABASE_PATH=./bridge.sqlite3
DEVIN_API_BASE_URL=https://api.devin.ai
DEVIN_MAX_ACU_LIMIT=3
DEVIN_POLL_FAST_SECONDS=1.0
DEVIN_POLL_SECONDS=5
DEVIN_WATCH_TIMEOUT_SECONDS=1800
DEVIN_ACTIVE_WATCH_TIMEOUT_SECONDS=86400
DEVIN_SETTLE_SECONDS=30
DEVIN_STATUS_AFTER_SECONDS=8
# See docs/configuration.md for a ready-made "product voice" reply style.
# Local-CLI backend (/platform local): binary + working dir for `devin acp`.
# DEVIN_LOCAL_CLI=devin
# DEVIN_LOCAL_CWD=
# DEVIN_SESSION_INSTRUCTIONS=
TELEGRAM_DEBOUNCE_SECONDS=1.5
TELEGRAM_QUEUE_WHILE_BUSY=true
TELEGRAM_LONG_REPLY_CHARS=3500
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
TELEGRAM_RICH_MESSAGES=true
TELEGRAM_DRAFTS=false
TELEGRAM_IMAGES_AS_DOCUMENTS=auto
# Comma-separated user ids, optionally labelled: 123:Ruben,456:Sarah
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOWED_CHAT_IDS=
# WARNING: true lets ANY Telegram user run Devin sessions on your account
# and ACU budget — only for intentionally public bots.
TELEGRAM_ALLOW_ALL_USERS=false
# TELEGRAM_FREE_RESPONSE_CHATS=
# Comma-separated site crawlers to pre-fetch before messages reach Devin
# (available: instagram, article). Empty = crawling off.
# CRAWL_SITES=
# TELEGRAM_HOME_CHANNEL=
TELEGRAM_NOTIFICATION_MODE=important
NOTIFY_SECRET=replace-with-notify-secret
DOCTOR_SECRET=replace-with-a-random-doctor-secret
ADMIN_SECRET=replace-with-a-random-admin-secret
# Keys the /admin set-env action is allowed to write. Tokens, keys and secrets
# are never readable or writable; the default list covers the non-secret keys.
# ADMIN_ENV_ALLOWLIST=
# Env file read and written by the /admin get-env and set-env actions.
# Relative paths resolve from the repo root.
# ADMIN_ENV_PATH=.env
# Log file tailed by the /admin logs action.
# ADMIN_LOG_PATH=/var/log/telegram-devin-bridge.log
# Command run by the /admin restart action. Empty exits the process so the
# supervisor (systemd, launchd, the Windows loop, Docker) respawns it.
# ADMIN_RESTART_COMMAND=
# BOT_USERNAME=
TELEGRAM_ADMIN_USER_IDS=
# TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_BACKEND=api
TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_LANGUAGE=
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL=/opt/whisper.cpp/models/ggml-base.en.bin
# Greedy decoding + audio context sized to the clip (~2.5x faster on CPU);
# set to false for maximum accuracy.
# WHISPER_CPP_FAST=true
# Extra flags passed to whisper-cli. -f, -m and -o* are rejected.
# WHISPER_CPP_EXTRA_ARGS=
# TRANSCRIPTION_COMMAND=
# TRANSCRIPTION_DOCKER_IMAGE=
TRANSCRIPTION_DOCKER_MEMORY=400m
TELEGRAM_ATTACH_VOICE=false
# GITHUB_TOKEN=
# Command run by /update and the /admin update action.
# SELF_UPDATE_COMMAND=sh deploy/self-update.sh
# Host-level only (conf.d / service env, never via /admin set-env):
# main | stable | vN | vN.N | vN.N.N
SELF_UPDATE_CHANNEL=main
